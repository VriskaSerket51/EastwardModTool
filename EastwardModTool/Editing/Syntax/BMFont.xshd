<SyntaxDefinition xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008" name="BMFont" extensions=".fnt">
    <Color name="Keyword" foreground="#C586C0" />
    <RuleSet>
        <Span color="String" multiline="false">
            <Begin>"</Begin>
            <End>"</End>
            <RuleSet>
                <Span color="Escape" begin="\\" end="." />
            </RuleSet>
        </Span>
        <Span color="String" multiline="false">
            <Begin>'</Begin>
            <End>'</End>
            <RuleSet>
                <Span color="Escape" begin="\\" end="." />
            </RuleSet>
        </Span>
        <Keywords color="Keyword">
            <Word>info</Word>
            <Word>common</Word>
            <Word>page</Word>
            <Word>chars</Word>
            <Word>char</Word>
            <Word>kernings</Word>
            <Word>kerning</Word>
        </Keywords>
        <Rule color="FieldName">\b[A-Za-z_]\w*(?=\s*=)</Rule>
        <Rule color="Number">(?&lt;![\w.])(?:0[xX][0-9a-fA-F]+(?:\.[0-9a-fA-F]*)?(?:[pP][+-]?\d+)?|-?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?)[uUlLfF]*\b</Rule>
    </RuleSet>
    <Color name="String" foreground="#CE9178" />
    <Color name="Escape" foreground="#D7BA7D" />
    <Color name="Number" foreground="#B5CEA8" />
    <Color name="FieldName" foreground="#9CDCFE" />
</SyntaxDefinition>

<SyntaxDefinition xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008" name="CSV" extensions=".csv">
    <RuleSet>
        <Span color="String" multiline="true">
            <Begin>"</Begin>
            <End>"(?!")</End>
            <RuleSet>
                <Span color="Escape" begin="&quot;" end="&quot;" />
            </RuleSet>
        </Span>
        <Rule color="Number">(?&lt;![\w.])(?:0[xX][0-9a-fA-F]+(?:\.[0-9a-fA-F]*)?(?:[pP][+-]?\d+)?|-?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?)[uUlLfF]*\b</Rule>
        <Rule color="Punctuation">,</Rule>
    </RuleSet>
    <Color name="String" foreground="#CE9178" />
    <Color name="Escape" foreground="#D7BA7D" />
    <Color name="Number" foreground="#B5CEA8" />
    <Color name="Punctuation" foreground="#D4D4D4" />
</SyntaxDefinition>
